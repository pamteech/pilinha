<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Só necessário se o app for empacotado com App Sandbox (Xcode / distribuição).
	     `swift run` não usa sandbox e não precisa deste arquivo. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Saída de rede: BCB, brapi, CoinGecko e TradingView (WKWebView). -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
