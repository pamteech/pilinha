{
  "expo": {
    "name": "Pilinvest",
    "slug": "pilinha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pilinha-icon.png",
    "scheme": "pilinha",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.pamtech.pilinha",
      "supportsTablet": false,
      "icon": "./assets/images/pilinha-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSFaceIDUsageDescription": "O Pilinvest usa o Face ID para abrir o app e mostrar os valores escondidos."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.pamtech.pilinha"
        ]
      },
      "appleTeamId": "KLQPAH2X2H"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3E2A55",
          "image": "./assets/images/pilinha-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "@bacons/apple-targets",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#3E2A55"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Pilinvest usa o Face ID para abrir o app e mostrar os valores escondidos."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "ios"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bab2b20b-ae57-4ec1-b9bc-fadb0be99792"
      }
    },
    "owner": "pamssoares"
  }
}
